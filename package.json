{
  "name": "autocheckin",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "扫码即用的自动签到桌面应用",
  "author": {
    "name": "AutoCheckin Contributors",
    "email": "256862649@qq.com"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.5",
    "pnpm": ">=10"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.11.0",
    "element-plus": "^2.10.7",
    "qrcode": "^1.5.4",
    "vue": "^3.5.18",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.17.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "nock": "^14.0.10",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.0.5"
  },
  "build": {
    "appId": "com.autocheckin.desktop",
    "productName": "AutoCheckin",
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      },
      {
        "from": "resources/tray@2x.png",
        "to": "tray@2x.png"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "icon": "resources/icon.png",
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "AutoCheckin Contributors <256862649@qq.com>",
      "category": "Utility"
    }
  }
}
