{
  "name": "autocheckin",
  "version": "1.0.1",
  "private": true,
  "description": "Local-first automatic check-in manager",
  "author": {
    "name": "AutoCheckin Contributors",
    "email": "256862649@qq.com"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.vue",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.11.0",
    "drizzle-orm": "^0.44.4",
    "electron-store": "^10.1.0",
    "element-plus": "^2.10.7",
    "node-cron": "^4.2.1",
    "playwright": "^1.54.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "zod": "^4.0.17"
  },
  "optionalDependencies": {
    "better-sqlite3": "11.8.1",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.17.1",
    "@playwright/test": "^1.54.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^37.2.6",
    "electron-vite": "^4.0.0",
    "electron-builder": "^26.0.12",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.33.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "nock": "^14.0.10",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  },
  "build": {
    "appId": "com.autocheckin.desktop",
    "productName": "AutoCheckin",
    "asarUnpack": ["**/*.node", "node_modules/playwright/**", "node_modules/playwright-core/**"],
    "npmRebuild": false,
    "files": ["out/**/*", "resources/**/*", "package.json"],
    "extraResources": [{ "from": "resources/adapters", "to": "adapters" }],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": {
      "target": ["AppImage", "deb"],
      "maintainer": "AutoCheckin Contributors <256862649@qq.com>",
      "category": "Utility"
    }
  }
}
